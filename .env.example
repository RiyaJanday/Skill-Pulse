# Copy to .env (git-ignored) for docker compose. Compose also reads values already set in your Windows environment.

# Password for the Postgres container (set on first start; to change it later run `docker compose down -v` first)
DB_PASSWORD=change-me

# Only if you set ML_SERVICE_KEY in ml-service/.env, put the SAME value here so the backend can send it
ML_SERVICE_KEY=

# Optional: email sending (password reset, weekly email)
MAIL_USERNAME=
MAIL_PASSWORD=
