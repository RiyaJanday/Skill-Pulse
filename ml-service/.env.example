# Copy to .env and fill in. Every provider is optional; they are tried in this order.

# Shared secret: the Java backend must send it as the X-Internal-Key header. Leave empty for local dev.
ML_SERVICE_KEY=

# LLM provider chain: Groq -> Gemini -> Ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=llama3.1:8b

LLM_TIMEOUT_SECONDS=40
# Overall deadline for the whole Groq -> Gemini -> Ollama chain (keep below Java's 60 s plan timeout)
LLM_TOTAL_TIMEOUT_SECONDS=45

# Train a model on synthetic data at startup if models/recall_xgb.json is missing
AUTO_TRAIN=true
